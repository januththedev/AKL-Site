{
  "name": "al-karrim-lanka",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Premium website for Al Karrim Lanka Consultant (Pvt) Ltd \u2014 international manpower recruitment since 1980.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/redesign/*.test.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:bootstrap": "node scripts/bootstrap-admin.mjs",
    "legacy:dev": "vite legacy-vite --config legacy-vite/vite.config.ts",
    "legacy:build": "vite build legacy-vite --config legacy-vite/vite.config.ts",
    "knowledge:import": "node scripts/import-knowledge.mjs",
    "preview": "node scripts/dev.mjs --production"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/space-grotesk": "^5.1.0",
    "@fontsource/instrument-serif": "^5.2.0",
    "@fontsource/manrope": "^5.2.0",
    "@google/model-viewer": "^4.3.1",
    "@neondatabase/auth": "0.7.0-beta",
    "gsap": "^3.12.5",
    "lenis": "^1.1.14",
    "lucide-react": "^0.462.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-router-dom": "^6.28.0",
    "sharp": "^0.34.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.20.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
